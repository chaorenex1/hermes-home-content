+# A work tree can hold a directory whose ``.git`` is not a usable repository (an
+# empty .git dir, a dead gitfile, a half-removed nested clone).  git treats it as
+# a repository boundary and aborts the entire ``git add -A`` with rc=128, which
+# would silently cost that project every checkpoint.  The path is debris, not
+# project content: exclude it and keep capturing the rest of the tree.
+_MALFORMED_NESTED_GIT_RE = re.compile(
+    r"'([^'\r\n]+?)[\\/]\.git' not recognized as a git repository")
+# Remembered per absolute work tree so later snapshots skip the failing add.
+_MALFORMED_NESTED_SKIPS: dict[str, set[str]] = {}
+_STAGE_ATTEMPTS = 4
+
+
+def _malformed_nested_git_path(stderr: str) -> Optional[str]:
+    """Work-tree-relative path of the broken nested repo named in a git error."""
+    match = _MALFORMED_NESTED_GIT_RE.search(stderr or "")
+    if match is None:
+        return None
+    path = match.group(1).replace("\\", "/").strip("/")
+    if not path or path.startswith("/") or re.match(r"^[A-Za-z]:", path):
+        return None
+    if any(part in {"", ".", ".."} for part in path.split("/")):
+        return None
+    return path
+
+
+def _stage_all(
+    store: Path,
+    working_dir: str,
+    index_file: Optional[Path] = None,
+) -> tuple[bool, str, str]:
+    """``git add -A`` that survives a malformed nested repository.
+
+    Each offending path is excluded from the stage (never captured as a bogus
+    gitlink) and remembered for this work tree, so a later snapshot does not
+    pay the failing add again.
+    """
+    key = str(_normalize_path(working_dir))
+    excluded = _MALFORMED_NESTED_SKIPS.setdefault(key, set())
+    for _ in range(_STAGE_ATTEMPTS):
+        if excluded:
+            specs = [f":(exclude,literal){path}" for path in sorted(excluded)]
+            ok, out, err = _run_git(
+                ["add", "-A", "--", ".", *specs], store, working_dir,
+                timeout=_GIT_TIMEOUT * 2, index_file=index_file,
+                allowed_returncodes={128},
+            )
+        else:
+            ok, out, err = _run_git(
+                ["add", "-A"], store, working_dir,
+                timeout=_GIT_TIMEOUT * 2, index_file=index_file,
+                allowed_returncodes={128},
+            )
+        if ok:
+            return ok, out, err
+        broken = _malformed_nested_git_path(err)
+        if broken is None or broken in excluded:
+            logger.error(
+                "Git add -A failed in %s (rc!=0) stderr=%s", working_dir, err)
+            return ok, out, err
+        excluded.add(broken)
+        logger.warning(
+            "Checkpoint: excluding %r from %s — its .git is not a usable git "
+            "repository, which makes git refuse to stage the rest of the work tree",
+            broken, working_dir)
+    return False, "", f"malformed nested repositories: {', '.join(sorted(excluded))}"
+
+
